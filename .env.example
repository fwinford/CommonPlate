# Must select a transaction-capable deployment: placement writes the request
# transition and its durable fulfillment record in one transaction, and startup
# fails closed against a standalone mongod. Locally that means a single-member
# replica set with the `replicaSet` parameter set — see "Local MongoDB must be a
# replica set" in README.md.
MONGO_URI=mongodb://127.0.0.1:27017/commonplate_development?replicaSet=rs0
PORT=3000
RESEND_API_KEY=replace-with-development-key
BASE_URL=http://localhost:3000
CRON_ENABLED=false
NODE_ENV=development
PUBLIC_ACTIONS_PAUSED=true
# Required for claim-token HMAC protection. Use at least 32 random UTF-8 bytes.
CLAIM_TOKEN_HMAC_SECRET=
