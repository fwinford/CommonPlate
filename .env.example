# Must select a transaction-capable deployment: placement writes the request
# transition and its durable fulfillment record in one transaction, and startup
# fails closed against a standalone mongod. Locally that means a single-member
# replica set with the `replicaSet` parameter set — see "Local MongoDB must be a
# replica set" in README.md.
MONGO_URI=mongodb://127.0.0.1:27017/commonplate_development?replicaSet=rs0
PORT=3000
RESEND_API_KEY=replace-with-development-key
BASE_URL=http://localhost:3000
# Gates only the hourly expired-request cleanup backup. Digest, daily
# subscriber-count reset, and SendLog-failure monitoring register independently;
# docs/system-contract.md is authoritative for scheduled-job behavior.
CRON_ENABLED=false
NODE_ENV=development
PUBLIC_ACTIONS_PAUSED=true
# Required for claim-token HMAC protection. Use at least 32 random UTF-8 bytes.
CLAIM_TOKEN_HMAC_SECRET=

# --- Optional: email sender ---------------------------------------------
# From address for operator alert mail only. Requester confirmation, helper
# alerts, and digests use their own hard-coded sender. Must be a domain
# verified with Resend.
FROM_EMAIL=CommonPlate <noreply@example.invalid>

# --- Optional: send-failure monitoring -----------------------------------
# Comma-separated operator recipients for the failed-send alert. Leave empty
# to disable monitoring entirely — the job returns before querying.
MONITOR_EMAILS=
# Failed SendLog entries in the trailing hour that trigger that alert.
MONITOR_THRESHOLD=10

# --- Optional: proxy awareness -------------------------------------------
# Set to 1 or true when running behind a proxy that sets X-Forwarded-For, so
# rate limiting keys on the real client IP. Enabled automatically when
# NODE_ENV=production; leave unset for local development.
TRUST_PROXY=

# --- Local tooling only, never set in a deployed environment --------------
# Required by `npm run seed:ui`. The script additionally refuses production
# mode and production-like database names — see "UI test fixture" in README.md.
ALLOW_LOCAL_SEED=false

# Set only by `npm run test:mongo`, which starts a throwaway replica set on a
# free port and injects this itself. Leave unset: the *.mongo.test.ts suites
# skip when it is absent, so a stale value here silently redirects integration
# tests at whatever database it names.
MONGO_INTEGRATION_URI=
